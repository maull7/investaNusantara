# Salin ke .env di server lalu isi. docker compose membaca file ini.
APP_NAME=NusantaraNews
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Alamat publik yang dibuka pengunjung (lewat Nginx host), mis. http://76.13.22.54:8081
APP_URL=http://IP_SERVER:PORT_NGINX
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Port aplikasi di dalam server (hanya 127.0.0.1); Nginx host mem-proxy ke sini.
APP_PORT=8080
# Redis milik compose, di 127.0.0.1:DOCKER_REDIS_PORT (beda dari Redis host 6379).
DOCKER_REDIS_PORT=6380
# Jalankan migrasi otomatis setiap container app start.
RUN_MIGRATIONS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL yang sudah ada di server, lewat socket /var/run/mysqld (di-mount ke container).
# Mau lewat TCP? Isi DB_HOST=127.0.0.1 dan kosongkan DB_SOCKET.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_PORT=3306
DB_DATABASE=investanusantara
DB_USERNAME=investanusantara
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
# REDIS_HOST/REDIS_PORT diisi otomatis oleh docker-compose.yml.

FILESYSTEM_DISK=local
MAIL_MAILER=log

# Hermes berjalan di server yang sama: tidak perlu SSH tunnel.
HERMES_BASE_URL=http://127.0.0.1:8642/v1
# Isi dengan API_SERVER_KEY Hermes (sama seperti di .env investaNews). Boleh juga API_SERVER_KEY=.
HERMES_TOKEN=
HERMES_CONNECT_TIMEOUT=10
HERMES_TIMEOUT=90
HERMES_RUN_TIMEOUT=120
HERMES_POLL_SECONDS=2
HERMES_RUNS_ENDPOINT=/runs
