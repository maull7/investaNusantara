{
	# HTTPS is handled by the host's Nginx in front of this container.
	auto_https off
	admin off
	frankenphp
}

:80 {
	# No TCP port: the host's Nginx proxies to this unix socket (dir bind-mounted from the host).
	bind unix//run/app/app.sock|0666
	root * /app/public
	encode zstd br gzip

	# Vite assets have hashed names: cache them for a year.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Service worker and manifest: always revalidate, so a new version reaches readers at once.
	@pwa path /sw.js /site.webmanifest
	header @pwa Cache-Control "no-cache"

	# Unix-socket peers have REMOTE_ADDR "@"; only the host's Nginx can reach the socket, so
	# present it as 127.0.0.1 and trustProxies (bootstrap/app.php) keeps reading X-Forwarded-*.
	php_server {
		env REMOTE_ADDR 127.0.0.1
	}
}
