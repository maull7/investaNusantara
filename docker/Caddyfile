{
	# HTTPS is handled by the host's Nginx in front of this container.
	auto_https off
	admin off
	frankenphp
}

:{$APP_PORT:8080} {
	bind {$APP_BIND:127.0.0.1}
	root * /app/public
	encode zstd br gzip

	# Vite assets have hashed names: cache them for a year.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
