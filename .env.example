APP_NAME="NusantaraNews"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hermes AI agent (berita otomatis). Lokal: ssh -N -L 8642:127.0.0.1:8642 user@host
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cloudflare Turnstile (captcha di Masuk/Daftar). Kosongkan secret untuk mematikan.
# Kunci uji coba Cloudflare (selalu lolos): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_TOKEN=
HERMES_CONNECT_TIMEOUT=10
HERMES_TIMEOUT=90
HERMES_RUN_TIMEOUT=120
HERMES_POLL_SECONDS=2
HERMES_RUNS_ENDPOINT=/runs

# Notifikasi push berita breaking. Buat dengan: php artisan push:vapid (sekali saja, jangan diganti).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Project yang boleh memanggil POST /api/v1/integrations/register (daftar akun dari investastar/investanews).
# Format: nama:secret,nama2:secret2 (secret minimal 32 karakter, buat: openssl rand -hex 32).
INTEGRATION_API_KEYS=
